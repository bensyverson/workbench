.DS_Store

# agents
.claude/worktrees/

# job
# Jobs cache and its sidecars — disposable, rebuilt from .jobs/log
.jobs.db*
# This machine's replica id, identity and focus
.jobs/local.json

# Local, unchecked source material
local/

# Node (tests and scripts; the kit itself has no dependencies)
node_modules
npm-debug.log*
.npm/
coverage/
*.lcov
*.tsbuildinfo

# Local environment and secrets
.env
.env.*

# Script output, regenerated on demand
scripts/**/out/

# Not ignored on purpose: built wrapper HTML. The repo ships prebuilt
# wrappers for agents to fetch (see project/2026-11-23-delivery-decisions.md).

# local tool state
.timetattle-project.json
