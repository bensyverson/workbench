{
  "name": "gemmaze",
  "version": "1.0.0",
  "kit": "0.4",
  "description": "A grid game: one level of walls and gems, played with the D-pad.",
  "entry": {
    "dialect": "gemmaze.dialect.js",
    "grammar": "gemmaze.grammar.js",
    "ui": "gemmaze.ui.js",
    "runtime": "gemmaze.runtime.js"
  },
  "examples": [
    "examples/garden.js"
  ],
  "refusals": [
    {
      "module": "refusals/two-starts.js",
      "code": "M001"
    }
  ],
  "tests": [
    {
      "name": "tap-moves-one-cell",
      "example": "examples/garden.js",
      "inputs": [
        {
          "T": 0.5,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": false,
            "right": true
          }
        },
        {
          "T": 0.55,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": false,
            "right": false
          }
        }
      ],
      "expect": [
        {
          "at": 0.4,
          "state": {
            "player": [
              1,
              1
            ]
          }
        },
        {
          "at": 1,
          "state": {
            "player": [
              2,
              1
            ],
            "collected": 0,
            "held.right": false
          }
        },
        {
          "events": "picked",
          "count": 0
        }
      ]
    },
    {
      "name": "walls-block",
      "example": "examples/garden.js",
      "inputs": [
        {
          "T": 0.5,
          "in": "pad",
          "value": {
            "up": true,
            "down": false,
            "left": false,
            "right": false
          }
        },
        {
          "T": 0.6,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": false,
            "right": false
          }
        },
        {
          "T": 0.7,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": true,
            "right": false
          }
        },
        {
          "T": 0.8,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": false,
            "right": false
          }
        },
        {
          "T": 1.1,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": false,
            "right": true
          }
        },
        {
          "T": 1.2,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": false,
            "right": false
          }
        }
      ],
      "expect": [
        {
          "at": 1,
          "state": {
            "player": [
              1,
              1
            ],
            "held.left": false
          }
        },
        {
          "at": 1.5,
          "state": {
            "player": [
              2,
              1
            ]
          }
        }
      ]
    },
    {
      "name": "holding-repeats-and-picks-up",
      "example": "examples/garden.js",
      "inputs": [
        {
          "T": 0.5,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": false,
            "right": true
          }
        },
        {
          "T": 1,
          "in": "pad",
          "value": {
            "up": false,
            "down": false,
            "left": false,
            "right": false
          }
        }
      ],
      "expect": [
        {
          "at": 0.55,
          "state": {
            "player": [
              2,
              1
            ],
            "collected": 0
          }
        },
        {
          "at": 2,
          "state": {
            "player": [
              4,
              1
            ],
            "collected": 1,
            "gems.length": 4
          }
        },
        {
          "events": "picked",
          "records": [
            {
              "at": [
                4.5,
                1.5
              ],
              "collected": 1
            }
          ]
        }
      ]
    }
  ],
  "files": {
    "examples/garden.js": "sha256-+altbCc0iuTw4VQ6Zng9bFG03kgzOJRlFqrUqr4Z6F0=",
    "gemmaze.dialect.js": "sha256-9DDf/aAUYytrqhab5DR9ryWCcUBxiehg1p7AWY597aM=",
    "gemmaze.grammar.js": "sha256-6L8rNdP0CmAF7VBcB/sXjRBMPU4b5iKvt1hSTqfi++k=",
    "gemmaze.runtime.js": "sha256-VcOJrEmgxj3fq+Awj6PHti/3zoayeCSBW+TAC5jGrCk=",
    "gemmaze.ui.js": "sha256-oWFW6xQL2jLVjOolsUCnlC67h6iA0UVLTW/xl6y9Q5c=",
    "refusals/two-starts.js": "sha256-L3ufn64WoxpauFbfeE0V6kKfw3ELoFOt0Qq3P7Oi5rQ=",
    "sprites.png": "sha256-wVOZWeMW9DDm1K4yptwaCrzKZjAKzhtRJgYbJ8X7YiU="
  }
}
