{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": ["kit/**/*", "scripts/**/*.js", "scripts/**/*.d.ts", "examples/**/*.js", "test/**/*.js"],
  "exclude": ["node_modules", "examples/rings.js", "scripts/m0-probe", "scripts/define-trial/fixtures", "scripts/define-trial/runs", "scripts/compose-trial/fixtures", "scripts/compose-trial/runs", "scripts/api-pilot/reference", "scripts/api-pilot/hidden","**/out/**"]
}
